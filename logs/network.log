+			FlowIdTag t;
+			uint32_t qIndex = m_queue->GetLastQueue();
+			if (qIndex == 0){//this is a pause or cnp, send it immediately!
+				m_node->SwitchNotifyDequeue(m_ifIndex, qIndex, p);
