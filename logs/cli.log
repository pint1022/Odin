    76	    // communicator group input file is not given
    77	    if (comm_group_filename.find("empty") != std::string::npos) {
    78	        comm_groups.clear();
    79	        return;
    80	    }
    81	
    82	    ifstream inFile;
    83	    json j;
    84	    inFile.open(comm_group_filename);
    85	    inFile >> j;
    86	
    87	    for (json::iterator it = j.begin(); it != j.end(); ++it) {
    88	        std::string comm_group_name = it.key();
    89	        int comm_group_id = std::stoi(comm_group_name);
    90	
    91	        std::vector<int> involved_NPUs;
    92	        for (auto id : it.value()) {
    93	            involved_NPUs.push_back(id);
    94	        }
    95	
    96	        comm_groups[comm_group_id] =
    97	            new CommunicatorGroup(comm_group_id, involved_NPUs, sys);
    98	    }
    99	}
