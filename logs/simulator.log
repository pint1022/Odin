    11	def _time_to_ms(time_str):
    12	    s = str(time_str).strip().lower()
    13	    if s.endswith("ms"):
    14	        return float(s[:-2])
    15	    if s.endswith("us"):
    16	        return float(s[:-2]) / 1000.0
    17	    if s.endswith("ns"):
    18	        return float(s[:-2]) / 1000000.0
    19	    if s.endswith("s"):
    20	        return float(s[:-1]) * 1000.0
    21	    return float(s)
    22	
    23	def _ms_to_time(ms_value):
    24	    # Keep generator output in ms to match existing topology format.
    25	    return f"{ms_value:.9f}ms"
    26	
    27	def _latency_with_jitter(base_latency, jitter, rng):
    28	    base_ms = _time_to_ms(base_latency)
    29	    jitter_ms = _time_to_ms(jitter)
    30	    if jitter_ms <= 0:
    31	        return _ms_to_time(base_ms)
    32	    low = max(0.0, base_ms - jitter_ms)
    33	    high = base_ms + jitter_ms
    34	    return _ms_to_time(rng.uniform(low, high))
    35	
    36	def NichTopo_0(parameters):
    37	    # NichTopo_0: Full-bipartite CLOS design within each pod.
    38	    # Hierarchy:  GPU —NVLink→ NICH(NVSwitch) —NVLink-like→ ASW —NVLink-like→ PSW (multi-pod only)
    39	    #
    40	    # All links use the same NVLink-like high-speed fabric protocol.
    41	    # NICH→ASW and ASW→PSW have larger latency than GPU→NICH because of longer cable reach.
    42	    #
    43	    # Design rules:
    44	    #   - 4 GPUs per NICH.  NICH is the ns3 NVSwitch (type=2); no separate NICH layer.
    45	    #   - GPU→NICH: NVLink, each GPU has its own dedicated port (nvlink_bw / nv_latency).
    46	    #   - NICH→ASW: NVLink-like fabric. Each NICH connects to ALL 16 ASW in its pod (full bipartite).
    47	    #       Per-link BW  = gpu_per_nich × nvlink_bw / asw_per_pod  (bandwidth-balanced)
    48	    #                    = 4 × 4800G / 16 = 1200G per link.
    49	    #       Aggregate BW = gpu_per_nich × nvlink_bw = 4 × 4800G = 19.2T  (non-oversubscribed).
    50	    #   - ASW→PSW: NVLink-like fabric, higher latency for inter-pod reach.
    51	    #   - NICH-to-NICH within a pod: always exactly 1 ASW hop (any common ASW).
    52	    #   - <=448 GPUs (single pod): NO PSW — full connectivity via shared ASW.
    53	    #   - >448 GPUs (multi-pod): 16 PSW for inter-pod scale-out (ASW→PSW→ASW').
    54	    #   - gpu_per_server is forced to 4 so ns3's node2nvswitch maps each GPU correctly.
    55	
    56	    pod_num      = 8
    57	    gpu_per_nich = 4    # GPUs per SICH (= forced gpu_per_server for ns3)
    58	    nich_per_pod = 112
    59	    gpu_per_pod  = nich_per_pod * gpu_per_nich   # = 448
    60	
    61	    # full_bipartite=True  (default):
    62	    #   Each SICH → all 16 ASW in its pod.  Per-link BW = nvlink_bw×4/16 = 1200G.
    63	    #   Non-oversubscribed aggregate; any SICH pair is 1 ASW hop; no PSW for single pod.
    64	    #
    65	    # full_bipartite=False (non-rail, full ASW rate):
    66	    #   Each SICH → exactly 1 ASW at full nvlink_bw (4800G).  7 SICH/ASW, 16 ASW/pod.
    67	    #   ASW need PSW spine for inter-ASW routing even in single pod.
    68	    full_bipartite = parameters.get('full_bipartite', True)
    69	
    70	    if full_bipartite:
    71	        asw_per_pod   = 16          # fixed: 16 ASW per pod
    72	        nich_per_asw  = nich_per_pod  # all NICHs → all ASWs
    73	        # Each SICH→ASW link runs at FULL nvlink_bw (4800G) — NOT split.
    74	        # The SICH switch fabric supports 16 × 4800G uplinks independently.
    75	        asw_link_bw   = parameters['nvlink_bw']   # full 4800G per link
    76	        links_per_sich = asw_per_pod
    77	    else:
    78	        # Non-rail: 7 SICH/ASW, 16 ASW/pod, 1 link/SICH at full bandwidth (4800G)
    79	        nich_per_asw  = 7
    80	        asw_per_pod   = 16
    81	        asw_link_bw   = parameters['nvlink_bw']   # full 4800G per link — NOT degraded
    82	        links_per_sich = 1
    83	
    84	    # Force ns3 server-grouping to match SICH granularity.
    85	    parameters['gpu_per_server']      = gpu_per_nich
    86	    parameters['nv_switch_per_server'] = 1
    87	
    88	    expected_gpu = pod_num * gpu_per_pod
    89	    if parameters['gpu'] > expected_gpu:
    90	        raise ValueError("NichTopo_0 supports up to " + str(expected_gpu) + " GPUs.")
    91	    if parameters['gpu'] != expected_gpu:
    92	        warnings.warn("NichTopo_0 full scale is " + str(expected_gpu) + " GPUs; generating a partial topology.")
    93	
    94	    used_pods = max(1, int((parameters['gpu'] + gpu_per_pod - 1) / gpu_per_pod))
    95	    nich_num  = int((parameters['gpu'] + gpu_per_nich - 1) / gpu_per_nich)
    96	
    97	    if full_bipartite:
    98	        # ASW: always asw_per_pod (16) per used pod; no PSW for single pod.
    99	        parameters['asw_switch_num'] = used_pods * asw_per_pod
   100	        if parameters['gpu'] <= gpu_per_pod:
   101	            parameters['psw_switch_num'] = 0
   102	        elif parameters['psw_switch_num'] <= 0:
   103	            warnings.warn("NichTopo_0 with >448 GPUs requires PSW.\n psw_switch_num set to 16")
   104	            parameters['psw_switch_num'] = 16
   105	    else:
   106	        # Non-rail: ASW count = ceil(nich_num / nich_per_asw) per pod (partial pod gets fewer ASW).
   107	        asw_needed = math.ceil(nich_num / nich_per_asw)
   108	        parameters['asw_switch_num'] = asw_needed if used_pods == 1 else used_pods * asw_per_pod
   109	        # PSW always needed — ASW must route between each other even in single pod.
   110	        # For single pod: 1 spine switch is sufficient for ASW interconnect.
   111	        # Force PSW=1 for single pod regardless of default (overrides the default of 16).
   112	        if parameters['gpu'] <= gpu_per_pod:
   113	            parameters['psw_switch_num'] = 1
   114	        elif parameters['psw_switch_num'] <= 0:
   115	            parameters['psw_switch_num'] = 16
   116	
   117	    parameters['nics_per_aswitch'] = nich_per_asw
   118	
   119	    psw_jitter = parameters['psw_jitter'] if parameters['psw_jitter'] is not None else parameters['ib_jitter']
   120	    rng = random.Random(parameters['jitter_seed'])
   121	
   122	    if full_bipartite:
   123	        nvlink_bw_num = float(''.join(c for c in parameters['nvlink_bw'] if c.isdigit() or c == '.'))
   124	        print("NichTopo_0 [full-bipartite]: %d SICH/pod, %d ASW/pod, per-link=%s (NOT split, agg=%.0fT)"
   125	              % (nich_per_pod, asw_per_pod, asw_link_bw, nvlink_bw_num * asw_per_pod / 1000))
   126	        print("  SICH-to-SICH: always 1 ASW hop; no PSW for single-pod")
   127	    else:
   128	        print("NichTopo_0 [non-rail, full-rate]: %d SICH/ASW, %d ASW, per-link=%s (no rate degradation)"
   129	              % (nich_per_asw, parameters['asw_switch_num'], asw_link_bw))
   130	        print("  SICH→ASW: 1 link each at full bandwidth; PSW routes between ASW groups")
   131	    print("asw_switch_num: %d   psw_switch_num: %d" % (parameters['asw_switch_num'], parameters['psw_switch_num']))
   132	    print("Creating NichTopo_0 with %d pod(s), %d SICH, %d ASW, %d PSW."
   133	          % (used_pods, nich_num, parameters['asw_switch_num'], parameters['psw_switch_num']))
   134	
   135	    nv_switch_num  = nich_num
   136	    ext_switch_num = parameters['asw_switch_num'] + parameters['psw_switch_num']
   137	    nodes = parameters['gpu'] + nv_switch_num + ext_switch_num
   138	
   139	    # Links: GPU→SICH (1/GPU) + SICH→ASW (1 or 16 per SICH) + ASW→PSW
   140	    links = int(
   141	        parameters['gpu']                                              # GPU → SICH (NVLink)
   142	        + nich_num * links_per_sich                                    # SICH → ASW
   143	        + parameters['asw_switch_num'] * parameters['psw_switch_num']  # ASW → PSW
   144	    )
   145	
   146	    mode_tag = "bipartite" if full_bipartite else "nonrail"
   147	    file_name = (
   148	        "NichTopo_0_" + mode_tag + "_"
   149	        + str(parameters['gpu']) + "g_"
   150	        + str(parameters['gpu_per_server']) + "gps_"
   151	        + parameters['bandwidth'] + "_"
   152	        + parameters['gpu_type']
   153	    )
   154	    with open(file_name, 'w') as f:
   155	        print(file_name)
   156	        first_line = (
   157	            str(nodes) + " "
   158	            + str(parameters['gpu_per_server']) + " "
   159	            + str(nv_switch_num) + " "
   160	            + str(ext_switch_num) + " "
   161	            + str(links) + " "
   162	            + str(parameters['gpu_type'])
   163	        )
   164	        f.write(first_line + '\n')
   165	
   166	        # Line 2: SICH node IDs first, then ASW, then PSW.
   167	        nich_nodes = []
   168	        asw_switch = []
   169	        psw_switch = []
   170	        base = parameters['gpu']
   171	        for i in range(base, base + nv_switch_num):
   172	            nich_nodes.append(i)
   173	        for i in range(base + nv_switch_num, base + nv_switch_num + parameters['asw_switch_num']):
   174	            asw_switch.append(i)
   175	        for i in range(base + nv_switch_num + parameters['asw_switch_num'], nodes):
   176	            psw_switch.append(i)
   177	
   178	        sec_line = " ".join(str(n) for n in (nich_nodes + asw_switch + psw_switch))
   179	        f.write(sec_line + '\n')
   180	
   181	        # GPU → SICH  (NVLink, dedicated port per GPU)
   182	        for i in range(parameters['gpu']):
   183	            line = (
   184	                str(i) + " " + str(nich_nodes[i // gpu_per_nich]) + " "
   185	                + str(parameters['nvlink_bw']) + " "
   186	                + str(parameters['nv_latency']) + " "
   187	                + str(parameters['error_rate'])
   188	            )
   189	            f.write(line + '\n')
   190	
   191	        # SICH → ASW
   192	        # full_bipartite : each SICH → all ASW in its pod (16 links at 1200G)
   193	        # non-rail        : each SICH → 1 ASW (sequential grouping, 7 SICH/ASW, at full 4800G)
   194	        for i in range(nich_num):
   195	            pod_idx = min(i // nich_per_pod, pod_num - 1)
   196	            if full_bipartite:
   197	                for asw_in_pod in range(asw_per_pod):
   198	                    asw_idx = pod_idx * asw_per_pod + asw_in_pod
   199	                    if asw_idx < len(asw_switch):
   200	                        line = (
   201	                            str(nich_nodes[i]) + " " + str(asw_switch[asw_idx]) + " "
   202	                            + asw_link_bw + " "
   203	                            + _latency_with_jitter(parameters['latency'], parameters['asw_jitter'], rng) + " "
   204	                            + str(parameters['error_rate'])
   205	                        )
   206	                        f.write(line + '\n')
   207	            else:
   208	                # Non-rail: SICH i → its single ASW (no TP-group alignment)
   209	                in_pod_idx = i % nich_per_pod
   210	                asw_in_pod = min(in_pod_idx // nich_per_asw, parameters['asw_switch_num'] - 1)
   211	                asw_idx    = pod_idx * (parameters['asw_switch_num'] // max(1, used_pods)) + asw_in_pod
   212	                asw_idx    = min(asw_idx, len(asw_switch) - 1)
   213	                line = (
   214	                    str(nich_nodes[i]) + " " + str(asw_switch[asw_idx]) + " "
   215	                    + asw_link_bw + " "
   216	                    + _latency_with_jitter(parameters['latency'], parameters['asw_jitter'], rng) + " "
   217	                    + str(parameters['error_rate'])
   218	                )
   219	                f.write(line + '\n')
   220	
   221	        # ASW → PSW  (full bipartite).
   222	        # Single-pod spine uses the same bandwidth as all other links;
   223	        # multi-pod uses ap_bandwidth (inter-pod fabric).
   224	        # Latency uses ap_latency if set, otherwise falls back to latency.
   225	        psw_bw = parameters['bandwidth'] if parameters['gpu'] <= gpu_per_pod else parameters['ap_bandwidth']
   226	        psw_base_latency = parameters.get('ap_latency') or parameters['latency']
   227	        for i in asw_switch:
   228	            for j in psw_switch:
   229	                line = (
   230	                    str(i) + " " + str(j) + " "
   231	                    + str(psw_bw) + " "
   232	                    + _latency_with_jitter(psw_base_latency, psw_jitter, rng) + " "
   233	                    + str(parameters['error_rate'])
   234	                )
   235	                f.write(line + '\n')
   236	
   237	def NichTopo_Wide(parameters):
   238	    # NichTopo_Wide: Based on NichTopo_0 with larger, configurable GPU groups per SICH.
   239	    # Hierarchy:  GPU —NVLink→ SICH(NVSwitch) —NVLink-like→ ASW —NVLink-like→ PSW (multi-pod)
   240	    #
   241	    # Key differences vs NichTopo_0:
   242	    #   1. GPU→SICH bandwidth: 4800 Gbps per port (same as NichTopo_0).
   243	    #      Group sizes of 16 or 32 GPUs per SICH (vs 4 in NichTopo_0).
   244	    #   2. Latency model:
   245	    #      GPU→SICH:  25 ns one-way  →  intra-group RTT = 50 ns
   246	    #      SICH→ASW: 635 ns one-way  →  inter-group RTT = 25+635+635+25 = 1320 ns
   247	    #      (Same inter-group RTT as NichTopo_0; intra-group RTT halved to 50 ns.)
   248	    #   3. Pod uplink aggregate = 200 Tbps (SICH→ASW total per pod).
   249	    #      Per-link BW = 200T / (sich_per_pod × asw_per_pod):
   250	    #        16-GPU (28 SICH, 16 ASW): 200T / 448 ≈ 446 Gbps/link
   251	    #        32-GPU (14 SICH, 16 ASW): 200T / 224 ≈ 893 Gbps/link
   252	    #   4. Full bipartite: every SICH connects to all 16 ASW in its pod.
   253	    #   5. ≤448 GPUs (single pod): no PSW needed.
   254	    #   6. >448 GPUs (multi-pod): 16 PSW for inter-pod connectivity.
   255	
   256	    GPU_LINK_BW      = parameters['nvlink_bw']   # 4800Gbps (same as NichTopo_0)
   257	    POD_UPLINK_TBPS  = 200.0   # total SICH→ASW aggregate per pod (Tbps)
   258	    pod_num          = 8
   259	    gpu_per_pod      = 448     # same as NichTopo_0
   260	    asw_per_pod      = 16      # 16 ASW per pod
   261	
   262	    gpu_per_sich = parameters.get('gpu_per_group', 16)
   263	    if gpu_per_pod % gpu_per_sich != 0:
   264	        raise ValueError(
   265	            "NichTopo_Wide: gpu_per_group=%d must evenly divide gpu_per_pod=%d."
   266	            % (gpu_per_sich, gpu_per_pod))
   267	
   268	    sich_per_pod = gpu_per_pod // gpu_per_sich     # 28 (16-GPU) or 14 (32-GPU)
   269	
   270	    # SICH→ASW per-link bandwidth from 200T pod uplink budget.
   271	    sich_asw_bw  = int(POD_UPLINK_TBPS * 1000 / (sich_per_pod * asw_per_pod))  # 446 or 893 Gbps
   272	    asw_bw_str   = str(sich_asw_bw) + "Gbps"
   273	
   274	    # SICH→ASW latency: 635 ns one-way so that inter-group RTT =
   275	    #   GPU→SICH(25ns) + SICH→ASW(635ns) + ASW→SICH(635ns) + SICH→GPU(25ns) = 1320 ns.
   276	    asw_latency  = parameters['latency']   # 0.000635ms = 635ns one-way
   277	
   278	    # Force ns3 gpu_per_server to match SICH grouping.
   279	    parameters['gpu_per_server']      = gpu_per_sich
   280	    parameters['nv_switch_per_server'] = 1
   281	
   282	    expected_gpu = pod_num * gpu_per_pod
   283	    if parameters['gpu'] > expected_gpu:
   284	        raise ValueError(
   285	            "NichTopo_Wide supports up to %d GPUs (%d pods × %d GPUs/pod)."
   286	            % (expected_gpu, pod_num, gpu_per_pod))
   287	    if parameters['gpu'] != expected_gpu:
   288	        warnings.warn(
   289	            "NichTopo_Wide full scale is %d GPUs; generating partial topology." % expected_gpu)
   290	
   291	    used_pods = max(1, (parameters['gpu'] + gpu_per_pod - 1) // gpu_per_pod)
   292	    nich_num  = (parameters['gpu'] + gpu_per_sich - 1) // gpu_per_sich
   293	
   294	    # Switch counts.
   295	    parameters['asw_switch_num'] = used_pods * asw_per_pod
   296	    if parameters['gpu'] <= gpu_per_pod:
   297	        parameters['psw_switch_num'] = 0
   298	    elif parameters['psw_switch_num'] <= 0:
   299	        warnings.warn("NichTopo_Wide with >448 GPUs requires PSW. psw_switch_num set to 16")
   300	        parameters['psw_switch_num'] = 16

