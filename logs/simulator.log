   111	//   has not yet been called.
   112	
   113	//   - key: A MsgEventKey isntance.
   114	//   - value: A MsgEvent instance that indicates that Sys layer is waiting for a
   115	//   receive event to finish
   116	map<MsgEventKey, MsgEvent> sim_recv_waiting_hash;
   117	
   118	//   - key: A MsgEventKey isntance.
   119	//   - value: The number of bytes that ns3 has simulated completed, but the
   120	//   System layer has not yet called sim_recv
   121	map<MsgEventKey, int> received_msg_standby_hash;
   122	
   123	// send_flow commands the ns3 simulator to schedule a RDMA message to be sent
   124	// between two pair of nodes. send_flow is triggered by sim_send.
   125	void send_flow(int src_id, int dst, int maxPacketCount,
   126	               void (*msg_handler)(void *fun_arg), void *fun_arg, int tag) {
   127	  // Get a new port number.
   128	  uint32_t port = portNumber[src_id][dst]++;
   129	  sender_src_port_map[make_pair(port, make_pair(src_id, dst))] = tag;
   130	  int pg = 3, dport = 100;
   131	  flow_input.idx++;
   132	
   133	  // Create a MsgEvent instance and register callback function.
   134	  MsgEvent send_event =
   135	      MsgEvent(src_id, dst, 0, maxPacketCount, fun_arg, msg_handler);
   136	  pair<MsgEventKey, int> send_event_key =
   137	      make_pair(make_pair(tag, make_pair(send_event.src_id, send_event.dst_id)),port) ;
   138	  sim_send_waiting_hash[send_event_key] = send_event;
   139	
   140	  // Create a queue pair and schedule within the ns3 simulator.
   141	  RdmaClientHelper clientHelper(
   142	      pg, serverAddress[src_id], serverAddress[dst], port, dport,
   143	      maxPacketCount,
   144	      has_win ? (global_t == 1 ? maxBdp : pairBdp[n.Get(src_id)][n.Get(dst)])
   145	              : 0,
   146	      global_t == 1 ? maxRtt : pairRtt[src_id][dst], msg_handler, fun_arg, tag,
   147	      src_id, dst);
   148	  ApplicationContainer appCon = clientHelper.Install(n.Get(src_id));
   149	  appCon.Start(Time(0));
   150	}
   151	
   152	// notify_receiver_receive_data looks at whether the System layer has issued
   153	// sim_recv for this message. If the system layer is waiting for this message,
   154	// call the callback handler for the MsgEvent. If the system layer is not *yet*
   155	// waiting for this message, register that this message has arrived,
   156	// so that the system layer can later call the callback handler when sim_recv
   157	// is called.
   158	void notify_receiver_receive_data(int src_id, int dst_id, int message_size,
   159	                                  int tag) {
   160	
   161	  MsgEventKey recv_expect_event_key = make_pair(tag, make_pair(src_id, dst_id));
   162	
   163	  if (sim_recv_waiting_hash.find(recv_expect_event_key) != sim_recv_waiting_hash.end()) {
   164	    // The Sys object is waiting for packets to arrive.
   165	    MsgEvent recv_expect_event = sim_recv_waiting_hash[recv_expect_event_key];
   166	    if (message_size == recv_expect_event.remaining_msg_bytes) {
   167	      // We received exactly the amount of data what Sys object was expecting.
   168	      sim_recv_waiting_hash.erase(recv_expect_event_key);
   169	      recv_expect_event.callHandler();
   170	    } else if (message_size > recv_expect_event.remaining_msg_bytes) {
   171	      // We received more packets than the Sys object is expecting.
   172	      // Place task in received_msg_standby_hash and wait for Sys object to issue more sim_recv
   173	      // calls. Call callback handler for the amount Sys object was waiting for.
   174	      received_msg_standby_hash[recv_expect_event_key] =
   175	          message_size - recv_expect_event.remaining_msg_bytes;
   176	      sim_recv_waiting_hash.erase(recv_expect_event_key);
   177	      recv_expect_event.callHandler();
   178	    } else {
   179	      // There are still packets to arrive.
   180	      // Reduce the number of packets we are waiting for. Do not call callback
   181	      // handler.
   182	      recv_expect_event.remaining_msg_bytes -= message_size;
   183	      sim_recv_waiting_hash[recv_expect_event_key] = recv_expect_event;
   184	    }
   185	  } else {
   186	    // The Sys object is not yet waiting for packets to arrive.
   187	    if (received_msg_standby_hash.find(recv_expect_event_key) == received_msg_standby_hash.end()) {
   188	      // Place task in received_msg_standby_hash and wait for Sys object to issue more sim_recv
   189	      // calls.
   190	      received_msg_standby_hash[recv_expect_event_key] = message_size;
   191	    } else {
   192	      // Sys object is still waiting. Add number of bytes we are waiting for.
   193	      received_msg_standby_hash[recv_expect_event_key] += message_size;
   194	    }
   195	  }
   196	
   197	  // Add to the number of total bytes received.
   198	  if (node_to_bytes_sent_map.find(make_pair(dst_id, 1)) == node_to_bytes_sent_map.end()) {
   199	    node_to_bytes_sent_map[make_pair(dst_id, 1)] = message_size;
   200	  } else {
   201	    node_to_bytes_sent_map[make_pair(dst_id, 1)] += message_size;
   202	  }
   203	}
   204	
   205	void notify_sender_sending_finished(int src_id, int dst_id, int message_size,
   206	                                    int tag, int src_port) {
   207	  // Lookup the send_event registered at send_flow().
   208	  pair<MsgEventKey, int> send_event_key = make_pair(make_pair(tag, make_pair(src_id, dst_id)), src_port);
   209	  if (sim_send_waiting_hash.find(send_event_key) == sim_send_waiting_hash.end()) {
   210	    cerr << "Cannot find send_event in sent_hash. Something is wrong."
   211	         << "tag, src_id, dst_id: " << tag << " " << src_id << " " << dst_id
   212	         << "\n";
   213	    exit(1);
   214	  }
   215	
   216	  // Verify that the (ns3 identified) sent message size matches what was
   217	  // expected by the system layer.
   218	  MsgEvent send_event = sim_send_waiting_hash[send_event_key];
   219	  if (send_event.remaining_msg_bytes != message_size) {
   220	    cerr << "The message size does not match what is expected. Something is "
   221	            "wrong."
   222	         << "tag, src_id, dst_id, expected msg_bytes, actual msg_bytes: " << tag
   223	         << " " << src_id << " " << dst_id << " "
   224	         << send_event.remaining_msg_bytes << " " << message_size << "\n";
   225	    exit(1);
   226	  }
   227	  sim_send_waiting_hash.erase(send_event_key);
   228	
   229	  // Add to the number of total bytes sent.
   230	  if (node_to_bytes_sent_map.find(make_pair(src_id, 0)) == node_to_bytes_sent_map.end()) {
   231	    node_to_bytes_sent_map[make_pair(src_id, 0)] = message_size;
   232	  } else {
   233	    node_to_bytes_sent_map[make_pair(src_id, 0)] += message_size;
   234	  }
   235	  send_event.callHandler();
   236	}
   237	
   238	void qp_finish_print_log(FILE *fout, Ptr<RdmaQueuePair> q) {
   239	  uint32_t sid = ip_to_node_id(q->sip), did = ip_to_node_id(q->dip);
   240	  uint64_t base_rtt = pairRtt[sid][did], b = pairBw[sid][did];
   241	  uint32_t total_bytes =
   242	      q->m_size +
   243	      ((q->m_size - 1) / packet_payload_size + 1) *
   244	          (CustomHeader::GetStaticWholeHeaderSize() -
   245	           IntHeader::GetStaticSize()); // translate to the minimum bytes
   246	                                        // required (with header but no INT)
   247	  uint64_t standalone_fct = base_rtt + total_bytes * 8000000000lu / b;
   248	  // sip, dip, sport, dport, size (B), start_time, fct (ns), standalone_fct (ns)
   249	  fprintf(fout, "%08x %08x %u %u %lu %lu %lu %lu\n", q->sip.Get(), q->dip.Get(),
   250	          q->sport, q->dport, q->m_size, q->startTime.GetTimeStep(),
   251	          (Simulator::Now() - q->startTime).GetTimeStep(), standalone_fct);
   252	  fflush(fout);
   253	}
   254	
   255	// qp_finish is triggered by NS3 to indicate that an RDMA queue pair has
   256	// finished. qp_finish is registered as the callback handlerto the RdmaClient
   257	// instance created at send_flow. This registration is done at
   258	// common.h::SetupNetwork().
   259	void qp_finish(FILE *fout, Ptr<RdmaQueuePair> q) {
   260	  uint32_t sid = ip_to_node_id(q->sip), did = ip_to_node_id(q->dip);
   261	  qp_finish_print_log(fout, q);
   262	
   263	  // remove rxQp from the receiver.
   264	  Ptr<Node> dstNode = n.Get(did);
   265	  Ptr<RdmaDriver> rdma = dstNode->GetObject<RdmaDriver>();
   266	  rdma->m_rdma->DeleteRxQp(q->sip.Get(), q->m_pg, q->sport);
   267	
   268	  // Identify the tag of this message.
   269	  if (sender_src_port_map.find(make_pair(q->sport, make_pair(sid, did))) ==
   270	      sender_src_port_map.end()) {
   271	    cout << "could not find the tag, there must be something wrong" << endl;
   272	    exit(-1);
   273	  }
   274	  int tag = sender_src_port_map[make_pair(q->sport, make_pair(sid, did))];
   275	  sender_src_port_map.erase(make_pair(q->sport, make_pair(sid, did)));
   276	
   277	  // Let sender knows that the flow has finished.
   278	  notify_sender_sending_finished(sid, did, q->m_size, tag, q->sport);
   279	
   280	  // Let receiver knows that it has received packets.
   281	  notify_receiver_receive_data(sid, did, q->m_size, tag);
   282	}
   283	
   284	int setup_ns3_simulation(string network_configuration) {
   285	  if (!ReadConf(network_configuration))
   286	    return -1;
   287	
   288	  SetConfig();
   289	
   290	  if (!SetupNetwork(qp_finish)) {
   291	    return -1;
   292	  }
   293	
   294	  return 0;
   295	
   296	}
