     1	#!/usr/bin/env python3
     2	import argparse, math
     3	import numpy as np
     4	import pandas as pd
     5	from pathlib import Path
     6	import glob
     7	
     8	def norm(s: str) -> str:
     9	    return " ".join(str(s).strip().lower().replace("_", " ").split())
    10	
    11	def pick_col(cols, targets):
    12	    # cols: list of original column names
    13	    nmap = {c: norm(c) for c in cols}
    14	    # exact match first
    15	    for t in targets:
    16	        for c, nc in nmap.items():
    17	            if nc == t:
    18	                return c
    19	    # contains match fallback
    20	    for c, nc in nmap.items():
    21	        ok = all(tok in nc for tok in targets[0].split())
    22	        if ok:
    23	            return c
    24	    return None
    25	
    26	def load_end2end_total_time(path: str):
    27	    df = pd.read_csv(path)
    28	    # Find "Total time" column robustly
    29	    col = pick_col(df.columns, targets=["total time"])
    30	    if col is None:
    31	        raise KeyError(f"Cannot find Total time column. Columns are: {list(df.columns)}")
    32	    return float(df[col].iloc[0]), df
    33	
    34	def safe_min_bw(algbw, busbw):
    35	    cands = []
    36	    if pd.notna(algbw) and float(algbw) > 0: cands.append(float(algbw))
    37	    if pd.notna(busbw) and float(busbw) > 0: cands.append(float(busbw))
    38	    return min(cands) if cands else math.nan
    39	
    40	def main():
    41	    ap = argparse.ArgumentParser()
    42	    ap.add_argument("--end2end_csv", required=True)
    43	    ap.add_argument("--detail_csv", required=True)
    44	    ap.add_argument("--payload_bytes", type=int, default=9000)
    45	    ap.add_argument("--p", type=float, default=1/1000)
    46	    ap.add_argument("--delta_ns", type=float, default=50.0)
    47	    ap.add_argument("--samples", type=int, default=200000)
    48	    ap.add_argument("--seed", type=int, default=1)
    49	
    50	    # units of *_total_comm in your Detail CSV (from your paste, ns matches your EndToEnd totals)
    51	    ap.add_argument("--detail_time_unit", choices=["ns", "us"], default="ns")
    52	
    53	    # if your EndToEnd total time is in different unit, convert it (usually same as detail)
    54	    ap.add_argument("--end2end_time_unit", choices=["ns", "us"], default="ns")
    55	
    56	    args = ap.parse_args()
    57	
    58	    # ---- Load EndToEnd baseline total time
    59	    baseline, end2end_df = load_end2end_total_time(args.end2end_csv)
    60	
    61	    # convert baseline to ns for combining with extra_ns
    62	    if args.end2end_time_unit == "us":
    63	        baseline_ns = baseline * 1000.0
    64	    else:
    65	        baseline_ns = baseline * 1.0
    66	
    67	    # ---- Load Detail CSV (pandas will rename duplicate columns: algbw, algbw.1, algbw.2, ...)
    68	    d = pd.read_csv(args.detail_csv)
    69	
    70	    # Normalize column lookup (because some files have extra spaces)
    71	    col_layer = pick_col(d.columns, ["layer name"])
    72	    if col_layer is None:
    73	        col_layer = d.columns[0]  # best effort
    74	
    75	    # Required phase columns
    76	    fwd_ex = pick_col(d.columns, ["fwd exposed comm"])
    77	    wg_ex  = pick_col(d.columns, ["wg exposed comm"])
    78	    ig_ex  = pick_col(d.columns, ["ig exposed comm"])
    79	    fwd_tc = pick_col(d.columns, ["fwd total comm"])
    80	    wg_tc  = pick_col(d.columns, ["wg total comm"])
    81	    ig_tc  = pick_col(d.columns, ["ig total comm"])
    82	
    83	    if any(c is None for c in [fwd_ex, wg_ex, ig_ex, fwd_tc, wg_tc, ig_tc]):
    84	        raise KeyError(f"Missing needed columns. Columns are: {list(d.columns)}")
    85	
    86	    # Bandwidth columns: in your header they appear as algbw,busbw repeated 3 times
    87	    # pandas will name them: algbw,busbw,algbw.1,busbw.1,algbw.2,busbw.2
    88	    # We find them by prefix.
    89	    alg_cols = [c for c in d.columns if norm(c).startswith("algbw")]
    90	    bus_cols = [c for c in d.columns if norm(c).startswith("busbw")]
    91	
    92	    if len(alg_cols) < 3 or len(bus_cols) < 3:
    93	        raise KeyError(f"Expected 3 algbw/busbw columns; got alg={alg_cols}, bus={bus_cols}")
    94	
    95	    # Map phases -> (exposed_col, total_comm_col, algbw_col, busbw_col)
    96	    phases = {
    97	        "fwd": (fwd_ex, fwd_tc, alg_cols[0], bus_cols[0]),
    98	        "wg":  (wg_ex,  wg_tc,  alg_cols[1], bus_cols[1]),
    99	        "ig":  (ig_ex,  ig_tc,  alg_cols[2], bus_cols[2]),
   100	    }
   101	
   102	    # Convert detail total_comm time to ns-equivalent for bytes estimate.
   103	    # bytes ≈ time_ns * BW_GBps
   104	    time_mul = 1.0 if args.detail_time_unit == "ns" else 1000.0
   105	
   106	    # ---- Estimate total exposed packets on critical path
   107	    total_packets_exposed = 0
   108	
   109	    for ph, (ex_col, tc_col, alg_col, bus_col) in phases.items():
   110	        ex = pd.to_numeric(d[ex_col], errors="coerce").fillna(0.0)
   111	        tc = pd.to_numeric(d[tc_col], errors="coerce").fillna(0.0)
   112	        alg = pd.to_numeric(d[alg_col], errors="coerce")
   113	        bus = pd.to_numeric(d[bus_col], errors="coerce")
   114	
   115	        # only where exposed comm exists and total comm exists
   116	        mask = (ex > 0) & (tc > 0)
   117	        if not mask.any():
   118	            continue
   119	
   120	        ex_m = ex[mask].to_numpy()
   121	        tc_m = tc[mask].to_numpy()
   122	        alg_m = alg[mask].to_numpy()
   123	        bus_m = bus[mask].to_numpy()
   124	
   125	        for exposed_t, total_t, a, b in zip(ex_m, tc_m, alg_m, bus_m):
   126	            bw = safe_min_bw(a, b)
   127	            if math.isnan(bw) or bw <= 0:
   128	                continue
   129	
   130	            # estimate message bytes from total_comm time and effective bw
   131	            msg_bytes = (total_t * time_mul) * bw  # (ns) * (GB/s) -> bytes
   132	            if msg_bytes <= 0:
   133	                continue
   134	
   135	            n_packets = int(math.ceil(msg_bytes / args.payload_bytes))
   136	            if n_packets <= 0:
   137	                continue
   138	
   139	            # conservative: only the exposed fraction contributes to critical path
   140	            frac = min(1.0, max(0.0, float(exposed_t) / float(total_t)))
   141	            n_exp = int(math.ceil(n_packets * frac))
   142	            total_packets_exposed += n_exp
   143	
   144	    if total_packets_exposed <= 0:
   145	        raise RuntimeError("total_packets_exposed computed as 0. Check units/columns.")
   146	
   147	    # ---- Retry model: sum of binomials = Binomial(sum N, p)
   148	    rng = np.random.default_rng(args.seed)
   149	    retries = rng.binomial(n=total_packets_exposed, p=args.p, size=args.samples)
   150	    extra_ns = retries.astype(np.float64) * args.delta_ns
   151	
   152	    step_ns = baseline_ns + extra_ns
   153	
   154	    # nearest-rank percentiles
   155	    step_sorted = np.sort(step_ns)
   156	    def pr(q):
   157	        i = int(math.ceil(q * len(step_sorted)) - 1)
   158	        i = max(0, min(i, len(step_sorted) - 1))
   159	        return step_sorted[i]
   160	
   161	    p50 = pr(0.50)
   162	    p95 = pr(0.95)
   163	    p99 = pr(0.99)
   164	
   165	    print(f"Baseline total time ({args.end2end_time_unit}): {baseline}")
   166	    print(f"Baseline total time (ns): {baseline_ns:.3f}")
   167	    print(f"Total exposed packets (critical path approx): {total_packets_exposed}")
   168	    print(f"Expected extra delay (ns): {(total_packets_exposed * args.p * args.delta_ns):.3f}")
   169	    print(f"P50 step-time (ns): {p50:.3f}")
   170	    print(f"P95 step-time (ns): {p95:.3f}")
   171	    print(f"P99 step-time (ns): {p99:.3f}")
   172	
   173	if __name__ == "__main__":
   174	    main()
     1	# GPT-22B Small GPU Pod512 Sweep Implementation Plan
