   299	void qp_finish(FILE *fout, Ptr<RdmaQueuePair> q) {
   300	  uint32_t sid = ip_to_node_id(q->sip), did = ip_to_node_id(q->dip);
   301	  uint64_t base_rtt = pairRtt[sid][did], b = pairBw[sid][did];
   302	  uint32_t total_bytes =
   303	      q->m_size +
   304	      ((q->m_size - 1) / packet_payload_size + 1) *
   305	          (CustomHeader::GetStaticWholeHeaderSize() -
   306	           IntHeader::GetStaticSize()); 
   307	  uint64_t standalone_fct = base_rtt + total_bytes * 8000000000lu / b;
   308	  fprintf(fout, "%08x %08x %u %u %lu %lu %lu %lu\n", q->sip.Get(), q->dip.Get(),
   309	          q->sport, q->dport, q->m_size, q->startTime.GetTimeStep(),
   310	          (Simulator::Now() - q->startTime).GetTimeStep(), standalone_fct);
   311	  fflush(fout);
   312	
   313	  AstraSim::ncclFlowTag flowTag;
   314	  uint64_t notify_size;
   315	  {
   316	    #ifdef NS3_MTP
   317	    MtpInterface::explicitCriticalSection cs;
   318	    #endif
   319	    Ptr<Node> dstNode = n.Get(did);
   320	    Ptr<RdmaDriver> rdma = dstNode->GetObject<RdmaDriver>();
   321	    rdma->m_rdma->DeleteRxQp(q->sip.Get(), q->m_pg, q->sport);
   322	    MockNcclLog* NcclLog = MockNcclLog::getInstance();
   323	    NcclLog->writeLog(NcclLogLevel::DEBUG,"qp finish, src:  %d did:  %d port:  %d total bytes:  %llu at the tick:  %d",sid,did,q->sport,q->m_size,AstraSim::Sys::boostedTick());
   324	    if (sender_src_port_map.find(make_pair(q->sport, make_pair(sid, did))) ==
   325	        sender_src_port_map.end()) {
   326	      NcclLog->writeLog(NcclLogLevel::ERROR,"could not find the tag, there must be something wrong");
   327	      exit(-1);
   328	    }
   329	    flowTag = sender_src_port_map[make_pair(q->sport, make_pair(sid, did))];
   330	    sender_src_port_map.erase(make_pair(q->sport, make_pair(sid, did)));
   331	    received_chunksize[std::make_pair(flowTag.current_flow_id,std::make_pair(sid,did))]+=q->m_size;
   332	    if(!is_receive_finished(sid,did,flowTag)) {
   333	      #ifdef NS3_MTP
   334	      cs.ExitSection();
   335	      #endif
   336	      return; 
   337	    }
   338	    notify_size = received_chunksize[std::make_pair(flowTag.current_flow_id,std::make_pair(sid,did))];
   339	    received_chunksize.erase(std::make_pair(flowTag.current_flow_id,std::make_pair(sid,did)));    
   340	    #ifdef NS3_MTP
   341	    cs.ExitSection();
   342	    #endif
   343	  }
   344	  notify_receiver_receive_data(sid, did, notify_size, flowTag);
   345	}
