   107	void SendFlow(int src, int dst, uint64_t maxPacketCount,
   108	              void (*msg_handler)(void *fun_arg), void *fun_arg, int tag, AstraSim::sim_request *request) {
   109	  MockNcclLog*NcclLog = MockNcclLog::getInstance();
   110	  uint64_t PacketCount=((maxPacketCount+_QPS_PER_CONNECTION_-1)/_QPS_PER_CONNECTION_);
   111	  uint64_t leftPacketCount = maxPacketCount;
   112	  for(int index = 0 ;index<_QPS_PER_CONNECTION_;index++){
   113	  uint64_t real_PacketCount = min(PacketCount,leftPacketCount);
   114	  leftPacketCount-=real_PacketCount;
   115	  uint32_t port = portNumber[src][dst]++; 
   116	    {
   117	      #ifdef NS3_MTP
   118	      MtpInterface::explicitCriticalSection cs;
   119	      #endif
   120	      sender_src_port_map[make_pair(port, make_pair(src, dst))] = request->flowTag;
   121	      #ifdef NS3_MTP
   122	      cs.ExitSection();
   123	      #endif
   124	    }
   125	  int flow_id = request->flowTag.current_flow_id;
   126	  bool nvls_on = request->flowTag.nvls_on;
   127	  int pg = 3, dport = 100;
   128	  int send_lat = 6000;
   129	  const char* send_lat_env = std::getenv("AS_SEND_LAT");
   130	  if (send_lat_env) {
   131	    try {
   132	      send_lat = std::stoi(send_lat_env);
   133	    } catch (const std::invalid_argument& e) {
   134	      NcclLog->writeLog(NcclLogLevel::ERROR,"send_lat set error");
   135	      exit(-1);
   136	    }
   137	  }
   138	  send_lat *= 1000;
   139	  flow_input.idx++;
   140	  if(real_PacketCount == 0) real_PacketCount = 1;
   141	    MockNcclLog* NcclLog = MockNcclLog::getInstance();
   142	    NcclLog->writeLog(NcclLogLevel::DEBUG," [Packet sending event]  %dSendFlow to  %d channelid:  %d flow_id  %d srcip  %d dstip  %d size:  %llu at the tick:  %d",src,dst,tag,flow_id,serverAddress[src],serverAddress[dst],maxPacketCount,AstraSim::Sys::boostedTick());
   143	    NcclLog->writeLog(NcclLogLevel::DEBUG," request->flowTag [Packet sending event]  %dSendFlow to  %d tag_id:  %d flow_id  %d srcip  %d dstip  %d size:  %llu at the tick:  %d",request->flowTag.sender_node,request->flowTag.receiver_node,request->flowTag.tag_id,request->flowTag.current_flow_id,serverAddress[src],serverAddress[dst],maxPacketCount,AstraSim::Sys::boostedTick());
   144	  RdmaClientHelper clientHelper(
   145	      pg, serverAddress[src], serverAddress[dst], port, dport, real_PacketCount,
   146	      has_win ? (global_t == 1 ? maxBdp : pairBdp[n.Get(src)][n.Get(dst)]) : 0,
   147	      global_t == 1 ? maxRtt : pairRtt[src][dst], msg_handler, fun_arg, tag,
   148	      src, dst);
   149	  if(nvls_on) clientHelper.SetAttribute("NVLS_enable", UintegerValue (1));
   150	  {
   151	    #ifdef NS3_MTP
   152	    MtpInterface::explicitCriticalSection cs;
   153	    #endif
   154	    ApplicationContainer appCon = clientHelper.Install(n.Get(src));
   155	    appCon.Start(Time(send_lat));
   156	    waiting_to_sent_callback[std::make_pair(request->flowTag.current_flow_id,std::make_pair(src,dst))]++;
   157	    waiting_to_notify_receiver[std::make_pair(request->flowTag.current_flow_id,std::make_pair(src,dst))]++;
   158	    #ifdef NS3_MTP
   159	    cs.ExitSection();
   160	    #endif
   161	  }
   162	  NcclLog->writeLog(NcclLogLevel::DEBUG,"waiting_to_notify_receiver  current_flow_id  %d src  %d dst  %d count  %d",request->flowTag.current_flow_id,src,dst,waiting_to_notify_receiver[std::make_pair(request->flowTag.tag_id,std::make_pair(src,dst))]);
   163	  }
   164	}
