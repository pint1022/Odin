   239	void notify_sender_sending_finished(int sender_node, int receiver_node,
   240	                                    uint64_t message_size, AstraSim::ncclFlowTag flowTag) {
   241	  { 
   242	    MockNcclLog * NcclLog = MockNcclLog::getInstance();
   243	    #ifdef NS3_MTP
   244	    MtpInterface::explicitCriticalSection cs;
   245	    #endif    
   246	    int tag = flowTag.tag_id;        
   247	    if (sentHash.find(make_pair(tag, make_pair(sender_node, receiver_node))) !=
   248	      sentHash.end()) {
   249	      task1 t2 = sentHash[make_pair(tag, make_pair(sender_node, receiver_node))];
   250	      AstraSim::SendPacketEventHandlerData* ehd = (AstraSim::SendPacketEventHandlerData*) t2.fun_arg;
   251	      ehd->flowTag=flowTag;   
   252	      if (t2.count == message_size) {
   253	        sentHash.erase(make_pair(tag, make_pair(sender_node, receiver_node)));
   254	        if (nodeHash.find(make_pair(sender_node, 0)) == nodeHash.end()) {
   255	          nodeHash[make_pair(sender_node, 0)] = message_size;
   256	        } else {
   257	          nodeHash[make_pair(sender_node, 0)] += message_size;
   258	        }
   259	        #ifdef NS3_MTP
   260	        cs.ExitSection();
   261	        #endif
   262	        t2.msg_handler(t2.fun_arg);
   263	        goto sender_end_1st_section;
   264	      }else{
   265	        NcclLog->writeLog(NcclLogLevel::ERROR,"sentHash msg size != sender_node %d receiver_node %d message_size %lu flow_id ",sender_node,receiver_node,message_size);
   266	      }
   267	    }else{
   268	      NcclLog->writeLog(NcclLogLevel::ERROR,"sentHash cann't find sender_node %d receiver_node %d message_size %lu",sender_node,receiver_node,message_size);
   269	    }       
   270	    #ifdef NS3_MTP
   271	    cs.ExitSection();
   272	    #endif
   273	  }
   274	sender_end_1st_section:
   275	  return;
   276	}
