   330	# SimAI-Physical Usage
   331	The current simulator is compatible with the ns3 discrete event simulator as the network backend, as well as the physical network backend for physical packet injection.
   332	
   333	## Compile
   334	SimAI-Phy currently uses the roceV2 protocol for traffic generation. The compilation process requires dependencies on libverbs related to the RDMA physical device, as well as the MPI program. Before compilation, please verify that your environment can successfully run the basic RDMA perfetest traffic generation tool and that it supports the related MPI program.
   335	```bash
     1	/******************************************************************************
     2	This source code is licensed under the MIT license found in the
     3	LICENSE file in the root directory of this source tree.
     4	*******************************************************************************/
     5	
     6	#include "Workload.hh"
     7	#include "CSVWriter.hh"
     8	#include "Layer.hh"
     9	#include "astra-sim/system/MockNcclLog.h"
    10	
    11	namespace AstraSim {
    12	Workload::~Workload() {
    13	  if (end_to_end != nullptr) {
    14	    delete end_to_end;
    15	  }
    16	  if (detailed != nullptr) {
    17	    delete detailed;
    18	  }
    19	  if (dimension_utilization != nullptr) {
    20	    delete dimension_utilization;
    21	  }
    22	  for (int i = 0; i < SIZE; i++) {
    23	    delete layers[i];
    24	  }
    25	  if (layers != nullptr) {
    26	    delete[] layers;
    27	  }
    28	}
    29	Workload::Workload(
    30	    std::string run_name,
    31	    Sys* generator,
    32	    std::string name,
    33	    int TOTAL_PASS,
    34	    int total_rows,
    35	    int stat_row,
    36	    std::string path,
    37	    bool seprate_log) {
    38	  this->initialized = false;
    39	  this->layers = nullptr;
    40	  this->SIZE = 0;
    41	  this->counter = 0;
    42	  this->delay_loaded = false;
    43	  this->checkpoint_initiated = false;
    44	  this->collective_issued = false;
    45	  this->pending_collectives = 0;
    46	  this->current_state = LoopState::Forward_Pass;
    47	  this->parallelismPolicy = ParallelismPolicy::None;
    48	  // Backward-compatible defaults for older workload headers that do not
    49	  // specify all parallelism tokens (ep/pp/vpp/ga/all_gpus).
    50	  this->model_parallel_npu_group = 1;
