    75	bool is_sending_finished(int src,int dst,AstraSim::ncclFlowTag flowTag){
    76	  int tag_id = flowTag.current_flow_id;
    77	  if (waiting_to_sent_callback.count(
    78	          std::make_pair(tag_id, std::make_pair(src, dst)))) {
    79	    if (--waiting_to_sent_callback[std::make_pair(
    80	            tag_id, std::make_pair(src, dst))] == 0) {
    81	      waiting_to_sent_callback.erase(
    82	          std::make_pair(tag_id, std::make_pair(src, dst)));
    83	      return true;
    84	    }
    85	  }
    86	  return false;
    87	}
