   886	          rate /= 2;
   887	        }
   888	      }
   889				sw->m_mmu->ConfigNPort(sw->GetNDevices()-1);
   890				sw->m_mmu->ConfigBufferSize(buffer_size* 1024 * 1024);
   891				sw->m_mmu->node_id = sw->GetId();
