   279	void notify_sender_packet_arrivered_receiver(int sender_node, int receiver_node,
   280	                                    uint64_t message_size, AstraSim::ncclFlowTag flowTag) {
   281	  int tag = flowTag.channel_id;
   282	  if (sentHash.find(make_pair(tag, make_pair(sender_node, receiver_node))) !=
   283	      sentHash.end()) {
   284	    task1 t2 = sentHash[make_pair(tag, make_pair(sender_node, receiver_node))];
   285	    AstraSim::SendPacketEventHandlerData* ehd = (AstraSim::SendPacketEventHandlerData*) t2.fun_arg;
   286	    ehd->flowTag=flowTag;
   287	    if (t2.count == message_size) {
   288	      sentHash.erase(make_pair(tag, make_pair(sender_node, receiver_node)));
   289	      if (nodeHash.find(make_pair(sender_node, 0)) == nodeHash.end()) {
   290	        nodeHash[make_pair(sender_node, 0)] = message_size;
   291	      } else {
   292	        nodeHash[make_pair(sender_node, 0)] += message_size;
   293	      }
   294	      t2.msg_handler(t2.fun_arg);
   295	    }
   296	  }
   297	}
