    92	  MockNcclLog* NcclLog = MockNcclLog::getInstance();
    93	  if (waiting_to_notify_receiver.count(
    94	          std::make_pair(tag_id, std::make_pair(src, dst)))) {
    95	    NcclLog->writeLog(NcclLogLevel::DEBUG," is_receive_finished waiting_to_notify_receiver  tag_id  %d src  %d dst  %d count  %d",tag_id,src,dst,waiting_to_notify_receiver[std::make_pair(
    96	                     tag_id, std::make_pair(src, dst))]);
    97	    if (--waiting_to_notify_receiver[std::make_pair(
    98	            tag_id, std::make_pair(src, dst))] == 0) {
    99	      waiting_to_notify_receiver.erase(
   100	          std::make_pair(tag_id, std::make_pair(src, dst)));
   101	      return true;
   102	    }
   103	  }
   104	  return false;
   105	}
