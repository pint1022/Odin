   191	        size_t world_size_pos = model_info.find("world_size");
   192	        if (world_size_pos != std::string::npos) {
   193	            model_name = model_info.substr(0, world_size_pos - 1); 
   194	        }
   195	
   196	        
   197	        std::regex param_regex(R"((world_size|tp|pp|ep|gbs|mbs|seq)(\d+))");
   198	        std::smatch matches;
   199	
   200	        std::string params = model_info; 
   201	        while (std::regex_search(params, matches, param_regex)) {
   202	            std::string param_name = matches[1].str();
   203	            int param_value = std::stoi(matches[2].str());
   204	
   205	            if (param_name == "world_size") {
   206	                world_size = param_value;
   207	            } else if (param_name == "tp") {
   208	                tp = param_value;
   209	            } else if (param_name == "pp") {
   210	                pp = param_value;
   211	            } else if (param_name == "ep") {
   212	                ep = param_value;
   213	            } else if (param_name == "gbs") {
   214	                gbs = param_value;
   215	            } else if (param_name == "mbs") {
   216	                mbs = param_value;
   217	            } else if (param_name == "seq") {
   218	                seq = param_value;
   219	            }
   220	
   221	            
   222	            params = matches.suffix().str();
   223	        }
   224	
   225	        
   226	        int dp = world_size / (tp * pp); 
   227	        double ga = static_cast<double>(gbs) / (dp * mbs); 
   228	
   229	        std::ostringstream result;
   230	        result << model_name << '-' 
   231	            << "tp" << tp << '-'
   232	            << "pp" << pp << '-'
   233	            << "dp" << dp << '-'
   234	            << "ga" << static_cast<int>(ga) << '-'
   235	            << "ep" << ep << '-'
   236	            << "NVL" << this->net_work_param.gpus_per_server << '-'
   237	            << std::fixed << std::setprecision(1) << (this->net_work_param.bw_per_nic * 8) << "G" << '-'
   238	            << "DP" << this->net_work_param.dp_overlap_ratio << '-' ;
   239	        
   240	        this->res = result.str();
   241	        
   242	        
   243	    }
   244	    if (this->res_folder != "None"){
   245	        if (this->res_folder.back() != '/'){
   246	            this->res = this->res_folder + '/' + this->res;
   247	        }
   248	        else{
   249	            this->res = this->res_folder + this->res;
   250	        }
   251	
   252	    }
   253	    return 0;
   254	}
