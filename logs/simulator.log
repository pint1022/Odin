   100	int parse(int argc, char *argv[]) {
   101	    for (int i = 1; i < argc; ++i) {
   102	        std::string arg = argv[i];
   103	        if (arg == "-h" || arg == "--help") {
   104	            std::cout << "-w,     --workload          Workloads, default none" << std::endl;
   105	            std::cout << "-g,     --gpus              Number of GPUs, default 1" << std::endl;
   106	            std::cout << "-g_p_s, --gpus-per-server   GPUs per server" << std::endl;
   107	            std::cout << "-r,     --result            Output results path" << std::endl;
   108	            std::cout << "-nv, --nvlink     Nvlink" << std::endl;
   109	            std::cout << "-nic, --nic_busbw     NIC busbw" << std::endl;
   110	            std::cout << "-n_p_s, --bus-bandwidth     Bus bandwidth file" << std::endl;
   111	            std::cout << "-nic_t, --nic_type     NIC type(cx7,bf3),choose when disable nic " << std::endl;
   112	            std::cout << "-g_type, --gpu_type     GPU type(A100,H100),choose when disable nvlink " << std::endl;
   113	            std::cout << "-v, --visual    Enable visual output" << std::endl;
   114	            std::cout << "-dp_o, --dp_overlap    dp overlap ratio(Default 0)" << std::endl;
   115	            std::cout << "-ep_o, --ep_overlap    ep overlap ratio(Default 0)" << std::endl;
   116	            std::cout << "-tp_o, --tp_overlap    tp overlap ratio(Default 0)" << std::endl;
   117	            std::cout << "-pp_o, --pp_overlap    pp overlap ratio(Default 1)" << std::endl;
   118	            std::cout << "-l, --lang               Language of the report (en or ja), default en" << std::endl;
   119	            return 1;
   120	        } else if (arg == "-w" || arg == "--workload") {
   121	            if (++i < argc) this->workload = argv[i];
   122	        } else if (arg == "-g" || arg == "--gpus") {
   123	            if (++i < argc) this->gpus.push_back(std::stoi(argv[i]));
   124	        } else if (arg == "-r" || arg == "--result") {
   125	            if (++i < argc) this->res = argv[i];
   126	        } else if (arg == "-r_f" || arg == "--result_folder") {
   127	            if (++i < argc) this->res_folder = argv[i];
   128	        } else if (arg == "-g_p_s" || arg == "--gpus-per-server") {
   129	            if (++i < argc) this->net_work_param.gpus_per_server = std::stoi(argv[i]);
   130	        } else if (arg == "-nv" || arg == "--nvlink") {
   131	            if (++i < argc) this->net_work_param.nvlink_bw = std::stof(argv[i]);
   132	        } else if (arg == "-nic"|| arg == "--nic_busbw") {
   133	            if (++i < argc) this->net_work_param.bw_per_nic = std::stof(argv[i]);
   134	        } else if (arg == "-n_p_s" || arg == "--nic_per_server") {
   135	            if (++i < argc) this->net_work_param.nics_per_server = std::stoi(argv[i]);
   136	        } else if (arg == "-nic_t" || arg == "--nic_type") {
   137	            if (++i < argc) this->net_work_param.nic_type = argv[i];
   138	        } else if (arg == "-g_type" || arg == "--gpu_type") {
   139	            if (++i < argc) {
   140	                std::string gpu_type = argv[i];
   141	                if (gpu_type == "A100" || gpu_type == "a100") this->net_work_param.gpu_type = GPUType::A100;
   142	                else if (gpu_type == "A800" || gpu_type == "a800" ) this->net_work_param.gpu_type = GPUType::A800;
   143	                else if (gpu_type == "H100" || gpu_type == "h100") this->net_work_param.gpu_type = GPUType::H100;
   144	                else if (gpu_type == "H800" || gpu_type == "h800") this->net_work_param.gpu_type = GPUType::H800;
   145	                else if (gpu_type == "H20" || gpu_type == "h20") this->net_work_param.gpu_type = GPUType::H20;
   146	                else this->net_work_param.gpu_type = GPUType::NONE;
   147	            }
   148	        }else if (arg == "-v" || arg == "--visual") {
   149	            if (++i < argc) this->net_work_param.visual = std::stoi(argv[i]);
   150	        }else if (arg == "--dp_overlap" || arg == "-dp_o") {
   151	            if (++i < argc) this->net_work_param.dp_overlap_ratio = std::stof(argv[i]);
   152	        }else if (arg == "--tp_overlap" || arg == "-tp_o") {
   153	            if (++i < argc) this->net_work_param.tp_overlap_ratio = std::stof(argv[i]);
   154	        }else if (arg == "--ep_overlap" || arg == "-ep_o") {
   155	            if (++i < argc) this->net_work_param.ep_overlap_ratio = std::stof(argv[i]);
   156	        }else if (arg == "--pp_overlap" || arg == "-pp_o") {
   157	            if (++i < argc) this->net_work_param.pp_overlap_ratio = std::stof(argv[i]);
   158	        } else if (arg == "-l" || arg == "--lang") {
   159	            if (++i < argc) {
   160	                std::string lang_str = argv[i];
   161	                if (lang_str == "en" || lang_str == "ja") {
   162	                    this->lang = lang_str;
   163	                } else {
   164	                    std::cerr << "Error: Invalid language '" << lang_str << "'. Please use 'en' or 'ja'." << std::endl;
   165	                    return 1;
   166	                }
   167	            }
   168	        }
   169	        else {
   170	            return 1; 
   171	        }
   172	    }
   173	
   174	    if (!this->gpus.empty()) {
   175	        this->net_work_param.nvswitch_num = this->gpus[0] / this->net_work_param.gpus_per_server;
   176	        this->net_work_param.switch_num = 120 + this->net_work_param.gpus_per_server;
   177	        this->net_work_param.node_num = this->net_work_param.nvswitch_num + this->net_work_param.switch_num + this->gpus[0];
   178	    }
   179	
   180	    if (this->res == "None" ){
   181	        std::string full_path = this->workload;
   182	        std::string model_info = full_path;
   183	        size_t last_slash_pos = full_path.find_last_of('/');
   184	        if (last_slash_pos != std::string::npos) {
   185	            model_info = full_path.substr(last_slash_pos + 1); 
   186	        }
   187	        std::string model_name; 
   188	        int world_size = 0, tp = 0, pp = 0, ep = 0, gbs = 0, mbs = 0, seq = 0;
   189	
