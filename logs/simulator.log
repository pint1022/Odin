   166	void notify_receiver_receive_data(int sender_node, int receiver_node,
   167	                                  uint64_t message_size, AstraSim::ncclFlowTag flowTag) {
   168	  {
   169	    #ifdef NS3_MTP
   170	    MtpInterface::explicitCriticalSection cs;   
   171	    #endif                         
   172	    MockNcclLog* NcclLog = MockNcclLog::getInstance();
   173	    NcclLog->writeLog(NcclLogLevel::DEBUG," %d notify recevier:  %d message size:  %llu",sender_node,receiver_node,message_size);
   174	    int tag = flowTag.tag_id;   
   175	    if (expeRecvHash.find(make_pair(
   176	            tag, make_pair(sender_node, receiver_node))) != expeRecvHash.end()) {
   177	      task1 t2 =
   178	          expeRecvHash[make_pair(tag, make_pair(sender_node, receiver_node))];
   179	    MockNcclLog* NcclLog = MockNcclLog::getInstance();
   180	    NcclLog->writeLog(NcclLogLevel::DEBUG," %d notify recevier:  %d message size:  %llu t2.count:  %llu channle id:  %d",sender_node,receiver_node,message_size,t2.count,flowTag.channel_id);
   181	      AstraSim::RecvPacketEventHadndlerData* ehd = (AstraSim::RecvPacketEventHadndlerData*) t2.fun_arg;
   182	      if (message_size == t2.count) {
   183	        NcclLog->writeLog(NcclLogLevel::DEBUG," message_size = t2.count expeRecvHash.erase  %d notify recevier:  %d message size:  %llu channel_id  %d",sender_node,receiver_node,message_size,tag);
   184	        expeRecvHash.erase(make_pair(tag, make_pair(sender_node, receiver_node)));
   185	        #ifdef NS3_MTP
   186	        cs.ExitSection();
   187	        #endif
   188	        assert(ehd->flowTag.current_flow_id == -1 && ehd->flowTag.child_flow_id == -1);
   189	        ehd->flowTag = flowTag;
   190	        t2.msg_handler(t2.fun_arg);
   191	        goto receiver_end_1st_section;
   192	      } else if (message_size > t2.count) {
   193	        recvHash[make_pair(tag, make_pair(sender_node, receiver_node))] =
   194	            message_size - t2.count;
   195	        NcclLog->writeLog(NcclLogLevel::DEBUG,"message_size > t2.count expeRecvHash.erase %d notify recevier:  %d message size:  %llu channel_id  %d",sender_node,receiver_node,message_size,tag);
   196	        expeRecvHash.erase(make_pair(tag, make_pair(sender_node, receiver_node)));
   197	        #ifdef NS3_MTP
   198	        cs.ExitSection();
   199	        #endif
   200	        assert(ehd->flowTag.current_flow_id == -1 && ehd->flowTag.child_flow_id == -1);
   201	        ehd->flowTag = flowTag;
   202	        t2.msg_handler(t2.fun_arg);
   203	        goto receiver_end_1st_section;
   204	      } else {
   205	        t2.count -= message_size;
   206	        expeRecvHash[make_pair(tag, make_pair(sender_node, receiver_node))] = t2;
   207	      }
   208	    } else {
   209	      receiver_pending_queue[std::make_pair(std::make_pair(receiver_node, sender_node),tag)] = flowTag;
   210	      if (recvHash.find(make_pair(tag, make_pair(sender_node, receiver_node))) ==
   211	          recvHash.end()) {
   212	        recvHash[make_pair(tag, make_pair(sender_node, receiver_node))] =
   213	            message_size;
   214	      } else {
   215	        recvHash[make_pair(tag, make_pair(sender_node, receiver_node))] +=
   216	            message_size;
   217	      }
   218	    }
   219	    #ifdef NS3_MTP
   220	    cs.ExitSection();
   221	    #endif
   222	  receiver_end_1st_section:
   223	    {
   224	    #ifdef NS3_MTP
   225	    MtpInterface::explicitCriticalSection cs2;
   226	    #endif  
   227	    if (nodeHash.find(make_pair(receiver_node, 1)) == nodeHash.end()) {
   228	      nodeHash[make_pair(receiver_node, 1)] = message_size;
   229	    } else {
   230	      nodeHash[make_pair(receiver_node, 1)] += message_size;
   231	    }
   232	    #ifdef NS3_MTP
   233	    cs2.ExitSection();
   234	    #endif
   235	    }
   236	  }
   237	}
